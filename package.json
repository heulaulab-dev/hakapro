{
  "name": "hakapro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && bun run engine:typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "bun scripts/migrations/production-db-migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:server-boundary": "node scripts/check-server-boundary.mjs",
    "record:fixtures": "bun scripts/record-fixtures.ts",
    "build:check": "MARKET_DATA_SOURCE=arjum HEULATRADE_MARKET_API_BASE_URL=https://build-check.invalid HEULATRADE_MARKET_API_KEY=build-check DATABASE_URL=postgresql://build-check:build-check@127.0.0.1:5432/build_check BETTER_AUTH_URL=https://hakapro.heulaulab.xyz BETTER_AUTH_SECRET=compile-only-placeholder-at-least-32-characters GOOGLE_CLIENT_ID=compile-only GOOGLE_CLIENT_SECRET=compile-only BETTER_AUTH_ENVIRONMENT=production BETTER_AUTH_REHEARSAL_URL= SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASSWORD= SMTP_FROM= SMTP_SECURE= DEV_AUTH_BYPASS= next build",
    "check:prod-guards": "node scripts/check-prod-guards.mjs",
    "engine:dev": "bun --watch services/engine/src/main.ts",
    "engine:start": "bun services/engine/src/main.ts",
    "engine:typecheck": "tsc -p services/engine/tsconfig.json",
    "engine:db:generate": "drizzle-kit generate --config services/engine/drizzle.config.ts",
    "engine:db:migrate": "bun services/engine/src/db/migrate.ts",
    "engine:test:e2e": "ENGINE_E2E_DOCKER=1 vitest run services/engine/test/e2e",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run check:prod-guards && bun run check:server-boundary && bun run build:check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8",
    "@tanstack/react-virtual": "^3.14.13",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.13",
    "nuqs": "^2.10.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "1.3.14",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
