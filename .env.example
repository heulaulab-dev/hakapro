# Names only — never commit values. Copy to .env.local.

# Private Coolify PostgreSQL (server only; inject the internal URL in Coolify).
DATABASE_URL=

# Better Auth (server only). Each deployment's BETTER_AUTH_URL must match its environment:
#   production (main)  https://hakapro.heulaulab.xyz
#   staging            https://staging-hakapro.heulaulab.xyz
#   develop            https://dev-hakapro.heulaulab.xyz
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Deployment environment: "production" (default when empty), "staging", "develop" or the
# migration-only "rehearsal". Every deployment runs NODE_ENV=production; this selects the origin.
# Rehearsal also needs BETTER_AUTH_REHEARSAL_URL set to the same HTTPS origin as BETTER_AUTH_URL.
BETTER_AUTH_ENVIRONMENT=
BETTER_AUTH_REHEARSAL_URL=
# Google OAuth redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email/password is enabled only when all required SMTP fields are set.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local development only: DEV_AUTH_BYPASS=1 skips auth on market routes. Rejected in production.
# Without it (and without Better Auth config) protected routes answer 503 AUTH_NOT_CONFIGURED.
DEV_AUTH_BYPASS=

# Local e2e only: multiplies BFF rate limits (all tests share one IP). Ignored in production.
E2E_RATE_LIMIT_SCALE=

# Market data source selection: "fixture" (default, recorded samples) | "arjum" | "idx-bei"
MARKET_DATA_SOURCE=fixture

# Fixture mode only: "baseline" (frozen samples, used by e2e) or "recorded" (bun run record:fixtures). Unset = recorded if present.
FIXTURE_DATASET=

# Lane B — arjum provider (server-only secret)
HEULATRADE_MARKET_API_BASE_URL=
HEULATRADE_MARKET_API_KEY=

# Lane A — idx-bei Python market-api (server-only, private network)
# Data Engine / idx-bei lane: https URL, or http://<service-name>:<port> on the private Coolify network.
MARKET_API_URL=

# Data Engine strategy scans (E4) on /api/strategies, read from MARKET_API_URL's /v1/strategies. "1" = on.
# Off by default: the HAKA-17 rules are a draft awaiting owner approval.
STRATEGY_ENGINE_ENABLED=

# EOD alert job (/api/jobs/evaluate-alerts). Server-only secrets; never NEXT_PUBLIC_.
# Bearer secret for manual or Coolify scheduled-task calls.
ALERT_JOB_SECRET=
# Accepted for compatibility with existing manual callers; Coolify uses ALERT_JOB_SECRET.
CRON_SECRET=
